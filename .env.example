# Copy to .env and fill in the secrets. Lines left commented use the default.

# --- Databases -----------------------------------------------------------
# Local Postgres with the prepared catalog and embeddings (pipeline, product-data).
LOCAL_CONNECTION_STRING="postgresql://USER:PASSWORD@127.0.0.1:5432/livinit"
# Remote source database, read only (product-data preparation).
REMOTE_CONNECTION_STRING="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# --- Gemini --------------------------------------------------------------
# Gemini model calls and query embeddings.
GEMINI_API_KEY=""

# --- AI proxy (OpenAI-compatible) ------------------------------------------
# Serves Claude models: the reviewer, product preparation, and any
# pipeline stage whose model name does not start with "gemini".
AI_PROXY_BASE_URL="http://127.0.0.1:8317/v1"
AI_PROXY_API_KEY=""

# --- Pipeline models -------------------------------------------------------
# Model for every design stage (interpret, select, finish). Default: gemini-3.8-flash.
# LLM_DESIGN_MODEL=gemini-3.8-flash
# Test Haiku on every stage through the proxy instead:
# LLM_DESIGN_MODEL=claude-haiku-5-5

# Optional model and thinking level per stage (stage=model:level, level low by default).
# Proxy models get the level as reasoning_effort.
# LLM_STAGE_MODELS=select=claude-haiku-5-5:low,finish=gemini-3.8-flash:low

# Seconds before a slow model call gets a duplicate (0 turns it off). Default: 12.
# Use 0 with Haiku: its normal calls take longer than 12 s.
# MODEL_HEDGE_AFTER_S=12

# --- Jev ------------------------------------------------------------------
JEV_API_KEY=""
# JEV_MODEL=jev-1.13.0
# Jev uses: rank (order candidates per design) and check (style and attribute checks).
# JEV_USES=rank,check

# Largest share (0 to 1) of a design's products that other designs may also use.
# PRODUCT_REUSE_RATE=0.5

# --- Benchmark reviewer (scripts/review.py) ---------------------------------
# REVIEW_MODEL=claude-sonnet-5-5
# REVIEW_EFFORT=medium

# --- Product preparation (product-data) -------------------------------------
LLM_PROXY_MODEL="claude-sonnet-5-5"
# LLM_PROXY_EFFORT=
